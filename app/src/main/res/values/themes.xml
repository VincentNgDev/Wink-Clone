<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android: this is the app's single theme, applied below via
        android:theme="@style/Theme.Clonedwink" — it lives in `app` (not `core:ui`) because it's
        an AndroidManifest-only concern: no Kotlin/Compose code anywhere reads it, only this
        module's manifest does. It also needs the `material`/`appcompat` libraries on its
        classpath to resolve `Theme.Material3.DayNight.NoActionBar`'s attrs (colorPrimary, etc.)
        during resource verification — `core:ui` (a Compose-only module) doesn't depend on
        those, which is exactly what happens when this file is moved there instead: AAPT fails
        to link it as a standalone library resource.

        Every `item` below points at a semantic color name from `core:ui`'s colors.xml (not a
        raw hex) — those names resolve differently in light vs. dark mode via that module's
        values-night/colors.xml. A cross-module `@color/...` XML reference like this works fine
        because resource merging combines every module's res/ into one table at build time; it's
        only *code* references (Kotlin's `R.foo.bar`) that are scoped per-module (see
        MainActivity.kt/WinkNavHost.kt for that side of the split).

        values-night/themes.xml re-declares this same style (style resources don't merge
        across resource-qualifier folders) so it can flip the one item that genuinely differs
        by mode (the status bar icon color) while sharing these same color names.
    -->
    <style name="Theme.Clonedwink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color — used for the CTA button, selected carousel dot, etc. -->
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/brand_purple_dark</item>
        <!-- Secondary brand color — the warm pink accent from the carousel palette. -->
        <item name="colorSecondary">@color/brand_pink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/brand_pink_dark</item>
        <!-- Tertiary accent — the teal used on the third carousel slide. -->
        <item name="colorTertiary">@color/brand_teal</item>
        <item name="colorOnTertiary">@color/white</item>
        <!-- Screen background vs. raised surfaces (cards) — deliberately distinct so a
             MaterialCardView reads as "lifted" above the background instead of blending in. -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <!-- Status bar matches the screen background for an edge-to-edge, immersive feel
             instead of a separate colored bar at the top. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
